# Copy to web/.env.local for local work. On Vercel the same names go in
# Settings → Environment Variables (Production). Never commit the filled-in file.

# Online database. Neon: the pooled connection string (…-pooler…/neondb?sslmode=require).
# Locally: npm run db:local, then postgres://postgres:postgres@127.0.0.1:5434/postgres
DATABASE_URL=

# Auth.js. AUTH_SECRET: `npx auth secret`. Google OAuth client from the Google Cloud
# console, redirect URI <origin>/api/auth/callback/google.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The public origin, only when it differs from what the request says (Tailscale Serve).
AUTH_URL=

# Who may sign in (comma-separated). Empty refuses everyone.
AUTH_OWNER_EMAILS=

# Local development only: stands in for a signed-in user. Ignored in production.
AUTH_DEV_EMAIL=

# Pomovi bridge (../pomovi/docs/plans/restaurant-finder-bridge.md). Leave empty until
# Pomovi ships its endpoints; the app then shows the bridge as not configured.
POMOVI_BRIDGE_URL=
POMOVI_BRIDGE_TOKEN=

# Set to 1 for verbose Auth.js logs while debugging a failed sign-in.
AUTH_DEBUG=
